# Cisco FMC connection (read-only export)
FMC_HOST=https://fmcrestapisandbox.cisco.com
FMC_USERNAME=
FMC_PASSWORD=
# Optional: set when FMC has multiple domains or auto-discovery fails
FMC_DOMAIN_UUID=
# TLS: keep verification enabled; set FMC_CA_BUNDLE for lab/self-signed certs
FMC_VERIFY_SSL=true
FMC_CA_BUNDLE=
# Export behavior
FMC_TIMEOUT=60
LOG_LEVEL=INFO
